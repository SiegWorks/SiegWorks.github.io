{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voicon-license-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-13",
  "vars": {
    "STRIPE_PRODUCT_VOICON": "prod_UsGP6npD27uDAZ",
    "STRIPE_PRICE_VOICON_30": "price_1TsVsqJxX08uzFkDDMnK6zIl",
    "STRIPE_PRODUCT_DCS_LOCALIZER": "prod_UxgFgAYujUhGqu",
    "STRIPE_PRICE_DCS_LOCALIZER_30": "price_1TxktHJxX08uzFkDoecIfVAh"
  },
  "triggers": {
    "crons": [
      "15 18 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voicon-license-db",
      "database_id": "d43c7dd8-4dd5-472f-b0bc-40c1f4090af5"
    }
  ]
}
